# Help, settings and search open from a list that is not Home and return to it with its selection kept.
start ^ Tonight
key s => ^ Live sports: choose a sport
key Down => > WNBA
key ? => ^ Help
key Esc => > WNBA
key , => ^ Settings
key , => > WNBA
key / => ^ Search
key Esc => > WNBA
key Esc => ^ Tonight
